// =============================================================================
// Category Domain Schema
// =============================================================================
// Hierarchical product categories for organizing products.
// ID prefix: cat_ (auto-generated by PrismaService extension)
// Supports up to 3 levels of nesting (root -> child -> grandchild).
// @see Story 3.4 - Categories Management
// @see Story 3.R2 - Prefixed IDs Foundation
// =============================================================================

model Category {
  id          String    @id @default(cuid())
  storeId     String    @map("store_id")
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  parentId    String?   @map("parent_id")
  imageUrl    String?   @map("image_url") @db.VarChar(2048)
  position    Int       @default(0)
  depth       Int       @default(0) // 0=root, 1=child, 2=grandchild (max 3 levels)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]  @relation("CategoryHierarchy")
  products ProductCategory[]

  // Constraints
  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, parentId])
  @@map("categories")
}
