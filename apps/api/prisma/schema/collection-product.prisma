// =============================================================================
// CollectionProduct Join Table Schema
// =============================================================================
// Many-to-many relationship between Collections and Products.
// Products can belong to multiple collections with custom ordering.
// No ID prefix needed (composite primary key).
// @see Story 3.5 - Collections Management (AC4, AC5)
// =============================================================================

model CollectionProduct {
  collectionId String   @map("collection_id")
  productId    String   @map("product_id")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId])
  @@map("collection_products")
}
