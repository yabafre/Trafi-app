// =============================================================================
// ProductMedia Domain Schema
// =============================================================================
// Media files (images, videos) associated with products and variants.
// ID prefix: med_ (auto-generated by PrismaService extension)
// Tenant isolation via Product relation (media doesn't have direct storeId).
// @see Story 3.3 - Product Media Upload
// =============================================================================

enum MediaType {
  IMAGE
  VIDEO
}

model ProductMedia {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  variantId    String?   @map("variant_id") // Optional: variant-specific image
  url          String    @db.VarChar(2048)  // Cloud storage URL (optimized WebP)
  thumbnailUrl String    @map("thumbnail_url") @db.VarChar(2048) // 400x400 thumbnail
  altText      String?   @map("alt_text") @db.VarChar(500) // Accessibility (NFR-A11Y-6)
  type         MediaType @default(IMAGE)
  position     Int       @default(0) // For ordering
  isPrimary    Boolean   @default(false) @map("is_primary")
  width        Int       // Original image dimensions
  height       Int
  sizeInBytes  Int       @map("size_in_bytes")
  mimeType     String    @map("mime_type") @db.VarChar(100) // Original format before WebP conversion
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Indexes for efficient lookups
  @@index([productId])   // Fast media listing for a product
  @@index([variantId])   // Fast variant-specific media lookup
  @@index([productId, position]) // Ordered media retrieval
  @@map("product_media")
}
