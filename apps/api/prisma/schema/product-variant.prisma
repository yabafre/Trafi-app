// =============================================================================
// ProductVariant Domain Schema
// =============================================================================
// Product variants with options (Size, Color), individual pricing, and inventory.
// ID prefix: var_ (auto-generated by PrismaService extension)
// Money fields use INTEGER cents (ARCH-25).
// Tenant isolation via Product relation (variants don't have direct storeId).
// @see Story 3.2 - Product Variants Management
// =============================================================================

enum WeightUnit {
  G
  KG
  OZ
  LB
}

model ProductVariant {
  id                    String     @id @default(cuid())
  productId             String     @map("product_id")
  sku                   String?    @db.VarChar(100)
  options               Json       // [{name: "Size", value: "M"}, {name: "Color", value: "Blue"}]
  priceInCents          Int        @map("price_in_cents") // Money as cents (ARCH-25): $19.99 = 1999
  compareAtPriceInCents Int?       @map("compare_at_price_in_cents") // Original price for "sale" display
  costPriceInCents      Int?       @map("cost_price_in_cents") // Cost for profit calculation
  taxRuleId             String?    @map("tax_rule_id") // Story 3.6 - Tax rule assignment
  quantity              Int        @default(0) // Available stock (not including reservations)
  trackInventory        Boolean    @default(true) @map("track_inventory")
  lowStockThreshold     Int        @default(5) @map("low_stock_threshold") // Story 3.7 - Low stock alert threshold
  allowOversell         Boolean    @default(false) @map("allow_oversell") // Story 3.7 - Allow negative stock (pre-orders)
  weight                Float?     // For shipping calculations
  weightUnit            WeightUnit @default(G) @map("weight_unit")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  // Relations
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxRule          TaxRule?           @relation(fields: [taxRuleId], references: [id]) // Story 3.6
  media            ProductMedia[]     // Story 3.3 - Variant-specific images
  inventoryHistory InventoryHistory[] // Story 3.7 - Inventory change history

  // Indexes for efficient lookups
  @@unique([productId, sku]) // SKU unique within a product
  @@index([productId]) // Fast variant listing for a product
  @@index([taxRuleId]) // Story 3.6 - Fast lookup by tax rule
  @@map("product_variants")
}
