// =============================================================================
// Product Domain Schema
// =============================================================================
// Product catalog entity for e-commerce.
// ID prefix: prod_ (auto-generated by PrismaService extension)
// Money fields use INTEGER cents (ARCH-25).
// All queries MUST be scoped by storeId for multi-tenancy (CRITICAL).
// @see Story 3.R2 - Prefixed IDs Foundation
// =============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id           String        @id @default(cuid())
  storeId      String        @map("store_id")
  name         String        // Product title/name (kept as 'name' for DB compatibility)
  slug         String
  description  String?
  priceInCents Int           @map("price_in_cents") // Money as cents (ARCH-25): $19.99 = 1999
  status       ProductStatus @default(DRAFT)
  productType  String?       @map("product_type") // e.g., "Physical", "Digital", "Service"
  vendor       String?       // Product vendor/brand
  tags         String[]      @default([]) // Array of tags for filtering
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at") // Soft delete (Principle #9)

  // Relations
  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  // Indexes for multi-tenancy and lookup queries
  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, deletedAt]) // For efficient soft-delete filtering
  @@map("products")
}
