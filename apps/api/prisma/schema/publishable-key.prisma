// =============================================================================
// PublishableKey Domain Schema
// =============================================================================
// Public API keys for storefront SDK authentication.
// Unlike ApiKey (secret keys for backend), these are safe to embed in frontend.
// ID prefix: pk_ (auto-generated by PrismaService extension)
// Key format: pk_live_{random} or pk_test_{random}
// Keys are stored in plain text (they're public, not secrets).
// Used for X-Trafi-Publishable-Key header resolution in StorefrontGuard.
// @see Story 3.8 - Oversell Prevention (scaffold)
// @see Epic 12 - SDK & API Experience (full implementation)
// =============================================================================

model PublishableKey {
  id        String    @id @default(cuid())
  storeId   String    @map("store_id")
  key       String    @unique // pk_live_xxx or pk_test_xxx (plain text - public key)
  name      String    @default("Default") // Human-readable name
  mode      String    @default("test") // "live" or "test"
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Indexes for efficient lookups
  @@index([storeId])
  @@index([key])
  @@index([storeId, mode, revokedAt]) // For listing active keys per store/mode
  @@map("publishable_keys")
}
