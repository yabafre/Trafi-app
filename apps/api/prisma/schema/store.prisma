// =============================================================================
// Store Domain Schema
// =============================================================================
// Multi-tenant store entity - the root of all tenant-scoped data.
// ID prefix: store_ (auto-generated by PrismaService extension)
// Users access stores via StoreMembership (multi-store RBAC).
// @see Story 3.R2 - Prefixed IDs Foundation
// @see Story 2-R1 - Multi-Store RBAC (StoreMembership Model)
// =============================================================================

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations - Multi-store RBAC via StoreMembership
  memberships           StoreMembership[]
  products              Product[]
  categories            Category[]
  collections           Collection[]
  taxRules              TaxRule[]
  apiKeys               ApiKey[]
  publishableKeys       PublishableKey[] // Story 3.8 - Storefront SDK keys
  auditLogs             AuditLog[]
  settings              StoreSettings?
  ownershipTransfers    OwnershipTransfer[]
  inventoryReservations InventoryReservation[] // Story 3.8 - Inventory reservations
  promotions            Promotion[]            // Story 3.9 - Promotions
  coupons               Coupon[]               // Story 3.9 - Coupon codes
  promotionUsages       PromotionUsage[]       // Story 3.9 - Usage tracking

  @@map("stores")
}
