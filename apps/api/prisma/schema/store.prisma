// =============================================================================
// Store Domain Schema
// =============================================================================
// Multi-tenant store entity - the root of all tenant-scoped data.
// ID prefix: store_ (auto-generated by PrismaService extension)
// @see Story 3.R2 - Prefixed IDs Foundation
// =============================================================================

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users              User[]
  products           Product[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  settings           StoreSettings?
  ownershipTransfers OwnershipTransfer[]

  @@map("stores")
}
