// =============================================================================
// User Domain Schema
// =============================================================================
// Admin users for store management (dashboard access).
// ID prefix: usr_ (auto-generated by PrismaService extension)
// Users can belong to MULTIPLE stores via StoreMembership (multi-store RBAC).
// @see Story 3.R2 - Prefixed IDs Foundation
// @see Story 2-R1 - Multi-Store RBAC (StoreMembership Model)
// =============================================================================

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique @db.Citext
  name             String?
  passwordHash     String      @map("password_hash")
  status           UserStatus  @default(INVITED)
  lastLoginAt      DateTime?   @map("last_login_at")
  refreshTokenHash String?     @map("refresh_token_hash")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // Relations - Multi-store RBAC via StoreMembership
  memberships           StoreMembership[]
  createdKeys           ApiKey[]
  transfersInitiated    OwnershipTransfer[]  @relation("TransferFrom")
  transfersReceived     OwnershipTransfer[]  @relation("TransferTo")
  inventoryAdjustments    InventoryHistory[]       // Story 3.7 - User who made inventory changes
  giftCardTransactions    GiftCardTransaction[]    // Story 3.10 - Gift card adjustments

  // Index for email lookups (global user, not store-scoped)
  @@index([email])
  @@map("users")
}
